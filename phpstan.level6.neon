########################################################################
# PHPStan, level 6, over the paths already typed for it. Same settings as
# phpstan.neon; `composer phpstan` runs both. Add a path here once it has
# no level 6 errors.
#
# CAUTION: PHPStan resolves `paths` RELATIVE TO THIS FILE.
########################################################################

includes:
    - phpstan.neon

parameters:
    level: 6
    paths!:
        - modules/Base/Update
        - modules/Base/Entity
        - modules/Base/Handler
        - modules/Base/Controller
        - modules/Sqs/Classes
        - modules/MaxmindGeoip/Classes
        - modules/Domstream/Classes
        - modules/Domstream/Update
        - Core
        - modules/Base/Classes/Beacon
        - modules/Base/Classes/Cube
        - modules/Base/Classes/Migration
        - modules/Base/Classes/Spam
        # Base Classes, file by file: every top-level class.
        - modules/Base/Classes/AppPasswords.php
        - modules/Base/Classes/Browscap.php
        - modules/Base/Classes/Cache.php
        - modules/Base/Classes/CompareMerger.php
        - modules/Base/Classes/Currency.php
        - modules/Base/Classes/CustomReportFavorites.php
        - modules/Base/Classes/CustomReports.php
        - modules/Base/Classes/DatabaseRequirement.php
        - modules/Base/Classes/Date.php
        - modules/Base/Classes/DbColumn.php
        - modules/Base/Classes/DimensionExpression.php
        - modules/Base/Classes/DimensionRegistry.php
        - modules/Base/Classes/EnvironmentCheck.php
        - modules/Base/Classes/Error.php
        - modules/Base/Classes/Event.php
        - modules/Base/Classes/EventDispatch.php
        - modules/Base/Classes/EventPredicate.php
        - modules/Base/Classes/FileEventQueue.php
        - modules/Base/Classes/FunnelStep.php
        - modules/Base/Classes/GeoEncodingRepair.php
        - modules/Base/Classes/Geolocation.php
        - modules/Base/Classes/GoalEventDefinitionPredicate.php
        - modules/Base/Classes/GoalMarking.php
        - modules/Base/Classes/GoalVocabulary.php
        - modules/Base/Classes/Ingest.php
        - modules/Base/Classes/InstallDatabase.php
        - modules/Base/Classes/InstallManager.php
        - modules/Base/Classes/JobLease.php
        - modules/Base/Classes/JobQueue.php
        - modules/Base/Classes/JobQueueLease.php
        - modules/Base/Classes/JobStatus.php
        - modules/Base/Classes/Mailer.php
        - modules/Base/Classes/MaterializedEvents.php
        - modules/Base/Classes/NotificationManager.php
        - modules/Base/Classes/PaginatedResultSet.php
        - modules/Base/Classes/ProfileDomains.php
        - modules/Base/Classes/PropertyGrants.php
        - modules/Base/Classes/PurchaseDeduplication.php
        - modules/Base/Classes/Realtime.php
        - modules/Base/Classes/ReportSegment.php
        - modules/Base/Classes/ResultSetManager.php
        - modules/Base/Classes/Retention.php
        - modules/Base/Classes/Sanitize.php
        - modules/Base/Classes/SchedulerHealth.php
        - modules/Base/Classes/Service.php
        - modules/Base/Classes/ServiceUser.php
        - modules/Base/Classes/Settings.php
        - modules/Base/Classes/SettingsForm.php
        - modules/Base/Classes/SiteManager.php
        - modules/Base/Classes/State.php
        - modules/Base/Classes/SystemHealth.php
        - modules/Base/Classes/TimePeriod.php
        - modules/Base/Classes/TouchBackfill.php
        - modules/Base/Classes/TrackerBundle.php
        - modules/Base/Classes/TrackerDefaults.php
        - modules/Base/Classes/TrackerIngest.php
        - modules/Base/Classes/TrackingEventHelpers.php
        - modules/Base/Classes/UserManager.php
        - modules/Base/Classes/V2Event.php
        - modules/Base/Classes/Validator.php
        - modules/Base/Classes/VisitorExpiry.php

    # OWA_EHS_* (handler return codes) are defined here, outside the paths.
    scanFiles:
        - modules/Base/Classes/EventDispatch.php
