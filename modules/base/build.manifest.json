{
    "packages": [
        {
            "name": "owa.tracker.js",
            "type": "js",
            "entry": "src/tracker/tracker-dom.js",
            "outputDir": "dist",
            "splitVendors": "owa.vendors"
        },
        {
            "name": "owa.reporting-combined-min.js",
            "type": "js",
            "entry": "src/reporting/v1/reporting-entry.js",
            "outputDir": "../../public/base/dist",
            "splitVendors": false
        },
        {
            "name": "owa.reporting-css-combined.css",
            "type": "css",
            "outputDir": "../../public/base/css",
            "files": [
                "css/jquery-ui.css",
                "css/ui.jqgrid.css",
                "css/chosen.css",
                "css/owa.css",
                "css/owa.admin.css",
                "css/owa.report.css"
            ],
            "copy": [
                {
                    "from": "css",
                    "to": ".",
                    "ignore": ["**/owa.reporting-css-combined.css", "**/index.php"]
                },
                {
                    "from": "i",
                    "to": "../i"
                }
            ]
        }
    ]
}
