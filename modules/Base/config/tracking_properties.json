            "required": true,
            "callbacks": [
                "owa_trackingEventHelpers::setUserName"
            ],
            "default_value": "(not set)"
        },
        "user_email": {
            "required": true,
            "callbacks": [
                "owa_trackingEventHelpers::setEmailAddress"
