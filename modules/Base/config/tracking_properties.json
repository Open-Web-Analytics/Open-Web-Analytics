            "required": false,
            "data_type": "url",
            "callbacks": [
                "owa_trackingEventHelpers::makeUrlCanonical"
            ]
        },
        "session_referer": {
            "required": false,
            "data_type": "url",
            "callbacks": [],
            "note": "Carried straight from the wire -- no callback, no default -- so it is on the event before the property pass starts. The old \"must come after session_referer\" comments on source/medium/search_terms described a constraint that never existed."
        },
        "source": {
            "required": true,
            "data_type": "string",
            "callbacks": [
                "owa_trackingEventHelpers::lowercaseString",
                "owa_trackingEventHelpers::deriveSource"
            ],
            "default_value": "(not set)",
            "note": "Independently settable at request time (utm_source). deriveSource only fills it in when the tracker sent nothing, by parsing session_referer."
        },
        "medium": {
            "required": true,
            "data_type": "string",
            "callbacks": [
                "owa_trackingEventHelpers::lowercaseString",
                "owa_trackingEventHelpers::deriveMedium"
            ],
            "default_value": "direct",
            "note": "Independently settable at request time (utm_medium). deriveMedium only fills it in when the tracker sent nothing, by classifying session_referer as referral, organic-search or social-network."
        },
        "search_terms": {
            "required": true,
            "callbacks": [
                "owa_trackingEventHelpers::extractSearchTerm"
            ],
            "default_value": "(not set)",
            "note": "Independently settable at request time. extractSearchTerm only fills it in when the tracker sent nothing, by reading the search engine query param off session_referer."
        },
        "feed_subscription_id": {
            "required": false,
            "callbacks": [],
            "default_value": null,
            "alternative_key": "sid"
        },
        "attribs": {
            "required": false,
            "data_type": "json",
            "callbacks": "",
            "default_value": ""
        }
