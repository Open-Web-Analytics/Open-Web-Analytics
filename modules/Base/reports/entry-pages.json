{
    "title": "Entry Pages",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "landingPage,landingPageTitle",
                "sort": "sessions-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "landingPage",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pagePath": "%s"
                },
                "valueColumns": "landingPage"
            }
        }
    ]
}
