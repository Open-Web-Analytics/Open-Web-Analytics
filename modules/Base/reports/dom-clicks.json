{
    "title": "Dom Clicks: ",
    "titleSuffix": "{pagePath}",
    "params": {
        "pagePath": {}
    },
    "metrics": "eventCount",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "chartMetric": "eventCount",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {eventCount.formatted} dom clicks for this web page."
        },
        {
            "type": "grid",
            "id": "domids",
            "container": "topDomIds",
            "title": "Dom IDs",
            "query": {
                "dimensions": "domElementId",
                "sort": "eventCount-",
                "resultsPerPage": 5
            }
        },
        {
            "type": "grid",
            "id": "domnames",
            "container": "topDomNames",
            "title": "Name Attributes",
            "query": {
                "dimensions": "domElementId",
                "sort": "eventCount-",
                "resultsPerPage": 5
            }
        },
        {
            "type": "grid",
            "id": "htmltags",
            "container": "topHtmlTags",
            "title": "HTML Tags",
            "query": {
                "dimensions": "domElementTag",
                "sort": "eventCount-",
                "resultsPerPage": 5
            }
        },
        {
            "type": "grid",
            "id": "domclasses",
            "container": "topDomClasses",
            "title": "Dom Classes",
            "query": {
                "dimensions": "domElementClass",
                "sort": "eventCount-",
                "resultsPerPage": 5
            }
        }
    ],
    "settings": {
        "constraints": [
            { "dimension": "pagePath", "fromParam": "pagePath" }
        ]
    }
}
