{
    "title": "Search Engine: ",
    "titleSuffix": "{referralWebSite}",
    "subview": "base.reportWidgets",
    "params": {
        "referralWebSite": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from this search engine."
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "medium",
                "value": "organic-search"
            },
            {
                "dimension": "referralWebSite",
                "fromParam": "referralWebSite"
            }
        ]
    }
}
