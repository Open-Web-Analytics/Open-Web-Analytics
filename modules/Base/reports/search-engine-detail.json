{
    "title": "Search Engine: ",
    "titleSuffix": "{referralWebSite}",
    "params": {
        "referralWebSite": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from this search engine."
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "medium",
                "value": "organic-search"
            },
            {
                "dimension": "referralWebSite",
                "fromParam": "referralWebSite"
            }
        ]
    }
}
