{
    "title": "Action Groups",
    "subview": "base.reportSimpleDimensional",
    "settings": {
        "dimensionLink": {
            "linkColumn": "actionGroup",
            "template": {
                "do": "base.report",
                "reportId": "action-group",
                "actionGroup": "%s"
            },
            "valueColumns": "actionGroup"
        },
        "dimensions": "actionGroup",
        "metrics": "actions,uniqueActions,actionsValue",
        "resultsPerPage": 25,
        "sort": "actions-",
        "trendChartMetric": "actions",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.actions.formatted_value *> actions for all action groups."
    }
}
