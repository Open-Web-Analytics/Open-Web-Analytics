{
    "title": "Action Groups",
    "subview": "base.reportWidgets",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "metrics": "actions,uniqueActions,actionsValue",
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.actions.formatted_value *> actions for all action groups.",
            "chartMetric": "actions"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "metrics": "actions,uniqueActions,actionsValue",
                "dimensions": "actionGroup",
                "sort": "actions-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "actionGroup",
                "template": {
                    "do": "base.report",
                    "reportId": "action-group",
                    "actionGroup": "%s"
                },
                "valueColumns": "actionGroup"
            }
        }
    ]
}
