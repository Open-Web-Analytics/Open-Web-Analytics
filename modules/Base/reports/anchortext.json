{
    "title": "Referral Link Text",
    "deprecated": {
        "message": "This report is for historical data only. The dimensions in this report are now deprecated."
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from referrals."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "referralLinkText",
                "sort": "visits-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "referralLinkText",
                "template": {
                    "do": "base.report",
                    "reportId": "referral-link-text-detail",
                    "referralLinkText": "%s"
                },
                "valueColumns": "referralLinkText"
            }
        }
    ],
    "settings": {
        "constraints": "medium==referral"
    }
}
