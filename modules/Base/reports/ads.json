{
    "title": "Ad Performance",
    "subview": "base.reportDimension",
    "settings": {
        "constraints": "ad!=null",
        "dimensionLink": {
            "linkColumn": "ad",
            "template": {
                "do": "base.report",
                "reportId": "ad-detail",
                "ad": "%s"
            },
            "valueColumns": "ad"
        },
        "dimensions": "ad",
        "gridTitle": "Top Ads",
        "metrics": "visits,pageViews,bounces",
        "resultsPerPage": 30,
        "sort": "visits-",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from ads."
    }
}
