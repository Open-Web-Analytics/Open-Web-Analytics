{
    "title": "Ad Performance",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from ads."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "sessionAd",
                "sort": "visits-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "sessionAd",
                "template": {
                    "do": "base.report",
                    "reportId": "ad-detail",
                    "sessionAd": "%s"
                },
                "valueColumns": "sessionAd"
            }
        }
    ],
    "settings": {
        "constraints": "ad!=null"
    }
}
