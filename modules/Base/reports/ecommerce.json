{
    "title": "Ecommerce",
    "metrics": "visits,transactions,transactionRevenue,ecommerceConversionRate,revenuePerVisit,revenuePerTransaction",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "transactions",
            "headline": "There were {transactions.formatted} {transactions|transaction|transactions} completed."
        },
        {
            "type": "grid-card",
            "id": "productName",
            "container": "productNameExplorer",
            "title": "Top Products",
            "colspan": 6,
            "query": {
                "metrics": "lineItemRevenue",
                "dimensions": "productName",
                "sort": "lineItemRevenue-"
            },
            "more": {
                "reportId": "products",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid",
            "id": "sessionSource",
            "container": "sourceExplorer",
            "title": "Revenue by Source",
            "colspan": 6,
            "query": {
                "metrics": "transactions,transactionRevenue",
                "dimensions": "sessionSource",
                "sort": "transactionRevenue-",
                "resultsPerPage": 5
            },
            "link": {
                "linkColumn": "sessionSource",
                "template": {
                    "do": "base.report",
                    "reportId": "sources",
                    "sessionSource": "%s"
                },
                "valueColumns": "sessionSource"
            }
        }
    ]
}
