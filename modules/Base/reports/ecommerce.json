{
    "title": "Ecommerce",
    "description": "Transactions, revenue and e-commerce conversion rate, with revenue by channel, the top orders and revenue by attributed source.",
    "metrics": "sessions,transactions,transactionRevenue,ecommerceConversionRate,revenuePerSession,revenuePerTransaction",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "transactions"
        },
        {
            "type": "grid-card",
            "id": "revenueByChannel",
            "container": "revenue-by-channel",
            "title": "Revenue by Channel",
            "colspan": 6,
            "query": {
                "metrics": "transactionRevenue",
                "dimensions": "attributedChannel",
                "sort": "transactionRevenue-"
            },
            "more": {
                "reportId": "channels"
            }
        },
        {
            "type": "grid-card",
            "id": "topOrders",
            "container": "top-orders",
            "title": "Top Orders",
            "colspan": 6,
            "query": {
                "metrics": "transactionRevenue",
                "dimensions": "transactionId",
                "sort": "transactionRevenue-"
            },
            "constraints": [
                {
                    "dimension": "eventName",
                    "value": "purchase"
                }
            ],
            "more": {
                "reportId": "transactions"
            }
        },
        {
            "type": "grid",
            "id": "attributedSource",
            "container": "sourceExplorer",
            "title": "Revenue by Source",
            "query": {
                "metrics": "transactions,transactionRevenue",
                "dimensions": "attributedSource",
                "sort": "transactionRevenue-",
                "resultsPerPage": 5
            },
            "link": {
                "linkColumn": "attributedSource",
                "template": {
                    "do": "base.report",
                    "reportId": "sources",
                    "attributedSource": "%s"
                },
                "valueColumns": "attributedSource"
            }
        }
    ]
}
