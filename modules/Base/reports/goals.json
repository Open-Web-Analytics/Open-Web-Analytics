{
    "title": "Goals",
    "description": "Goal events, their value and goal events per session, by day, and each goal event's count and value by channel.",
    "metrics": "sessions,goalEvents,goalValue,goalEventsPerSession",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 12,
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "goalEvents"
        },
        {
            "type": "grid",
            "id": "byGoal",
            "container": "goal-events",
            "title": "Goal Events",
            "colspan": 12,
            "query": {
                "metrics": "goalEvents,goalValue,totalUsers",
                "dimensions": "eventName,attributedChannel",
                "sort": "goalEvents-"
            },
            "constraints": [
                {
                    "dimension": "isGoalEvent",
                    "value": "1"
                }
            ]
        }
    ]
}
