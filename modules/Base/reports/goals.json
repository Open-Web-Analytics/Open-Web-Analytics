{
    "title": "Goals",
    "metrics": "visits,keyEvents,sessionKeyEventRate,goalAbandonRateAll,goalValueAll",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 12,
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "keyEvents",
            "headline": "There were {goalCompletionsAll.formatted} {goalCompletionsAll|goal|goals} completed."
        },
        {
            "type": "metric-boxes",
            "id": "goalMetrics",
            "container": "goalMetrics",
            "title": "Goal Performance",
            "colspan": 6,
            "boxWidth": "150px",
            "query": {
                "metrics": "@activeGoalCompletions"
            },
            "showTitle": true
        }
    ]
}
