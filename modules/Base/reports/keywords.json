{
    "view": "base.report",
    "title": "Referring Search Terms",
    "subview": "base.reportDimension",
    "settings": {
        "constraints": "medium==organic-search",
        "dimensionLink": {
            "linkColumn": "referralSearchTerms",
            "template": {
                "do": "base.reportKeywordDetail",
                "referralSearchTerms": "%s"
            },
            "valueColumns": "referralSearchTerms"
        },
        "dimensions": "referralSearchTerms",
        "resultsPerPage": 30,
        "sort": "visits-",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from search engines."
    }
}
