{
    "title": "Ad Type: ",
    "titleSuffix": "{adType}",
    "subview": "base.reportWidgets",
    "params": {
        "adType": {
            "lowercase": true
        }
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from this ad type."
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "adType",
                "fromParam": "adType"
            }
        ]
    }
}
