{
    "title": "Product SKUs",
    "subview": "base.reportWidgets",
    "metrics": "lineItemQuantity,lineItemRevenue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.lineItemQuantity.formatted_value *> products sold across all Categories.",
            "chartMetric": "lineItemQuantity"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "productCategory",
                "sort": "lineItemQuantity-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "productCategory",
                "template": {
                    "do": "base.report",
                    "reportId": "product-category-detail",
                    "productCategory": "%s"
                },
                "valueColumns": "productCategory"
            }
        }
    ]
}
