{
    "title": "Days To Purchase",
    "subview": "base.reportWidgets",
    "metrics": "transactions",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.transactions.formatted_value *> transactions from all visitors.",
            "chartMetric": "transactions"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "daysToTransaction",
                "sort": "daysToTransaction",
                "resultsPerPage": 30
            }
        }
    ]
}
