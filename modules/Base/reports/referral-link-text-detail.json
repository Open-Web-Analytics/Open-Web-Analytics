{
    "view": "base.report",
    "title": "Referral Link Text: ",
    "titleSuffix": "{referralLinkText}",
    "params": {
        "referralLinkText": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from links with this text."
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "referralLinkText",
                "fromParam": "referralLinkText"
            }
        ]
    }
}
