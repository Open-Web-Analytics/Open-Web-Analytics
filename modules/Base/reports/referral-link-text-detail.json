{
    "view": "base.report",
    "title": "Referral Link Text: ",
    "titleSuffix": "{referralLinkText}",
    "subview": "base.reportWidgets",
    "params": {
        "referralLinkText": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from links with this text."
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "referralLinkText",
                "fromParam": "referralLinkText"
            }
        ]
    }
}
