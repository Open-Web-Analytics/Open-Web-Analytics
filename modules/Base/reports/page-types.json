{
    "title": "Page Types",
    "subview": "base.reportWidgets",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "metrics": "visits,pageViews",
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.pageViews.formatted_value *> page views for all page types.",
            "chartMetric": "pageViews"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "metrics": "visits,pageViews",
                "dimensions": "pageType",
                "sort": "pageViews-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "pageType",
                "template": {
                    "do": "base.report",
                    "reportId": "page-type-detail",
                    "pageType": "%s"
                },
                "valueColumns": "pageType"
            }
        }
    ],
    "settings": {
        "gridTitle": "Top Page Types"
    }
}
