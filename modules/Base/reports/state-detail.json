{
    "title": "State/Region: ",
    "titleSuffix": "{stateRegion}",
    "subview": "base.reportDimension",
    "params": {
        "country": {},
        "stateRegion": {}
    },
    "settings": {
        "constraints": [
            {
                "dimension": "country",
                "fromParam": "country"
            },
            {
                "dimension": "stateRegion",
                "fromParam": "stateRegion"
            }
        ],
        "dimensions": "city,stateRegion",
        "resultsPerPage": 30,
        "sort": "visits",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from this state/region."
    }
}
