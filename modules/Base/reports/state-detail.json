{
    "title": "State/Region: ",
    "titleSuffix": "{stateRegion}",
    "params": {
        "country": {},
        "stateRegion": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from this state/region."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "city,stateRegion",
                "sort": "visits",
                "resultsPerPage": 30
            }
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "country",
                "fromParam": "country"
            },
            {
                "dimension": "stateRegion",
                "fromParam": "stateRegion"
            }
        ]
    }
}
