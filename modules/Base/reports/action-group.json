{
    "title": "Action Group: ",
    "titleSuffix": "{actionGroup}",
    "subview": "base.reportWidgets",
    "params": {
        "actionGroup": {}
    },
    "metrics": "actions,uniqueActions,actionsValue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.actions.formatted_value *> actions for this action group.",
            "chartMetric": "actions"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "actionGroup,actionName",
                "sort": "actions-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "actionName",
                "template": {
                    "do": "base.report",
                    "reportId": "action-detail",
                    "actionName": "%s",
                    "actionGroup": "%s"
                },
                "valueColumns": [
                    "actionName",
                    "actionGroup"
                ]
            },
            "excludeColumns": "'actionGroup'"
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "actionGroup",
                "fromParam": "actionGroup"
            }
        ]
    }
}
