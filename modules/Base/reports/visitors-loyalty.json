{
    "title": "Visitor Loyalty",
    "description": "Sessions by how many sessions the visitor had before.",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "priorSessionCount",
                "sort": "priorSessionCount",
                "resultsPerPage": 25
            }
        }
    ]
}
