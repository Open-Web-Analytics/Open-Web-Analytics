{
    "title": "Visitors",
    "metrics": "totalUsers,newUsers,sessions",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 12,
            "chartMetric": "totalUsers",
            "query": {
                "metrics": "totalUsers,newUsers",
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid-card",
            "id": "browserTypes",
            "container": "top-browsers",
            "title": "Browser Types",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "browserType",
                "sort": "sessions-"
            }
        },
        {
            "type": "grid-card",
            "id": "domains",
            "container": "visitor-domains",
            "title": "Domains",
            "query": {
                "metrics": "totalUsers",
                "dimensions": "hostName",
                "sort": "totalUsers-"
            },
            "more": {
                "reportId": "hosts",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "loyalty",
            "container": "visitor-loyalty",
            "title": "Visitor Loyalty",
            "query": {
                "metrics": "totalUsers",
                "dimensions": "priorSessionCount",
                "sort": "priorSessionCount"
            },
            "more": {
                "reportId": "visitors-loyalty",
                "label": "View Full Report \u00bb"
            }
        }
    ]
}
