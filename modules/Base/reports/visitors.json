{
    "title": "Visitors",
    "description": "Users, new users and sessions, by new or returning, device, country, browser, operating system and number of prior sessions.",
    "metrics": "totalUsers,newUsers,sessions",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 12,
            "chartMetric": "totalUsers",
            "query": {
                "metrics": "totalUsers,newUsers",
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "pie",
            "id": "visitorTypes",
            "container": "visitor-types",
            "title": "Visitor Types",
            "colspan": 4,
            "chartMetric": "sessions",
            "query": {
                "metrics": "sessions",
                "dimensions": "newVsReturning",
                "sort": "sessions-"
            }
        },
        {
            "type": "grid-card",
            "id": "deviceTypes",
            "container": "device-types",
            "title": "Device Types",
            "colspan": 4,
            "query": {
                "metrics": "sessions",
                "dimensions": "deviceType",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "devices"
            }
        },
        {
            "type": "grid-card",
            "id": "loyalty",
            "container": "visitor-loyalty",
            "title": "Visitor Loyalty",
            "query": {
                "metrics": "totalUsers",
                "dimensions": "priorSessionCount",
                "sort": "priorSessionCount"
            },
            "more": {
                "reportId": "visitors-loyalty"
            },
            "colspan": 4
        },
        {
            "type": "grid-card",
            "id": "countries",
            "container": "visitor-countries",
            "title": "Countries",
            "colspan": 4,
            "query": {
                "metrics": "sessions",
                "dimensions": "country",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "geolocation"
            }
        },
        {
            "type": "grid-card",
            "id": "browserTypes",
            "container": "top-browsers",
            "title": "Browser Types",
            "colspan": 4,
            "query": {
                "metrics": "sessions",
                "dimensions": "browserType",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "browsers"
            }
        },
        {
            "type": "grid-card",
            "id": "operatingSystems",
            "container": "top-operating-systems",
            "title": "Operating Systems",
            "colspan": 4,
            "query": {
                "metrics": "sessions",
                "dimensions": "osType",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "os"
            }
        }
    ]
}
