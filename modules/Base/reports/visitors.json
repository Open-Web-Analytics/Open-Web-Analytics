{
    "title": "Visitors",
    "metrics": "uniqueVisitors,newVisitors,repeatVisitors,visits,visitDuration",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 12,
            "chartMetric": "uniqueVisitors",
            "query": {
                "metrics": "uniqueVisitors,newVisitors,repeatVisitors,visitDuration",
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {uniqueVisitors.formatted} {uniqueVisitors|visitor|visitors} to this web site."
        },
        {
            "type": "grid-card",
            "id": "browserTypes",
            "container": "top-browsers",
            "title": "Browser Types",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "browserType",
                "sort": "visits-"
            },
            "link": {
                "linkColumn": "browserType",
                "template": {
                    "do": "base.report",
                    "reportId": "browser-detail",
                    "browserType": "%s"
                },
                "valueColumns": "browserType"
            }
        },
        {
            "type": "grid-card",
            "id": "domains",
            "container": "visitor-domains",
            "title": "Domains",
            "query": {
                "metrics": "uniqueVisitors",
                "dimensions": "hostName",
                "sort": "uniqueVisitors-"
            },
            "more": {
                "reportId": "hosts",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "loyalty",
            "container": "visitor-loyalty",
            "title": "Visitor Loyalty",
            "query": {
                "metrics": "uniqueVisitors",
                "dimensions": "priorVisitCount",
                "sort": "priorVisitCount"
            },
            "more": {
                "reportId": "visitors-loyalty",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "recency",
            "container": "visitor-recency",
            "title": "Visitor Recency",
            "query": {
                "metrics": "uniqueVisitors",
                "dimensions": "daysSinceLastVisit",
                "sort": "daysSinceLastVisit"
            },
            "more": {
                "reportId": "visitors-recency",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "age",
            "container": "visitor-age",
            "title": "Visitor Age",
            "query": {
                "metrics": "uniqueVisitors",
                "dimensions": "daysSinceFirstVisit",
                "sort": "daysSinceFirstVisit"
            },
            "more": {
                "reportId": "visitors-age",
                "label": "View Full Report \u00bb"
            }
        }
    ]
}
