{
    "title": "Content Overview",
    "metrics": "visits,pageViews,bounceRate",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "pageViews,pagesPerVisit,bounceRate"
            },
            "chartMetric": "pageViews",
            "headline": "There were {pageViews.raw} {pageViews|page view|page views} of all pages."
        },
        {
            "type": "grid-card",
            "id": "toppages",
            "container": "top-pages",
            "title": "Pages",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "pageTitle",
                "sort": "visits-"
            },
            "more": {
                "reportId": "pages",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "toppagetypes",
            "container": "top-pagetypes",
            "title": "Page Types",
            "colspan": 3,
            "query": {
                "metrics": "visits",
                "dimensions": "pageType",
                "sort": "visits-"
            },
            "link": {
                "linkColumn": "pageType",
                "template": {
                    "do": "base.report",
                    "reportId": "page-type-detail",
                    "pageType": "%s"
                },
                "valueColumns": "pageType"
            },
            "more": {
                "reportId": "page-types",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "entrypages",
            "container": "entry-pages",
            "title": "Entry Pages",
            "query": {
                "metrics": "visits",
                "dimensions": "entryPagePath",
                "sort": "visits-"
            },
            "more": {
                "reportId": "entry-pages",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "exitpages",
            "container": "exit-pages",
            "title": "Exit Pages",
            "query": {
                "metrics": "visits",
                "dimensions": "exitPagePath",
                "sort": "visits-"
            },
            "more": {
                "reportId": "exit-pages",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "clickedelements",
            "container": "clicked-elements",
            "title": "Most Clicked Elements",
            "query": {
                "metrics": "domClicks",
                "dimensions": "domElementId",
                "sort": "domClicks-"
            },
            "more": {
                "reportId": "clicks",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "report-links",
            "title": "Content Reports",
            "colspan": 3,
            "links": [
                {
                    "reportId": "domstreams",
                    "label": "Domstream Recordings",
                    "description": "See user mouse movement and keypress recordings."
                },
                {
                    "reportId": "action-tracking",
                    "label": "Actions",
                    "description": "See which actions your user performed."
                },
                {
                    "reportId": "entry-pages",
                    "label": "Entry Pages",
                    "description": "See which web pages users entered on."
                },
                {
                    "reportId": "exit-pages",
                    "label": "Exit Pages",
                    "description": "See which web pages users exited on."
                },
                {
                    "reportId": "feeds",
                    "label": "Feeds",
                    "description": "See trends for feed subscribers and usage."
                }
            ]
        }
    ]
}
