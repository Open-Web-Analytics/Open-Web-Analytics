{
    "title": "Content Overview",
    "metrics": "sessions,pageViews",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "pageViews,pageViewsPerSession"
            },
            "chartMetric": "pageViews"
        },
        {
            "type": "grid-card",
            "id": "toppages",
            "container": "top-pages",
            "title": "Pages",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "pageTitle",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "pages",
                "label": "View Full Report »"
            }
        },
        {
            "type": "grid-card",
            "id": "toppagetypes",
            "container": "top-pagetypes",
            "title": "Page Types",
            "colspan": 3,
            "query": {
                "metrics": "sessions",
                "dimensions": "contentGroup",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "page-types",
                "label": "View Full Report »"
            }
        },
        {
            "type": "grid-card",
            "id": "entrypages",
            "container": "entry-pages",
            "title": "Entry Pages",
            "query": {
                "metrics": "sessions",
                "dimensions": "landingPage",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "entry-pages",
                "label": "View Full Report »"
            }
        },
        {
            "type": "grid-card",
            "id": "exitpages",
            "container": "exit-pages",
            "title": "Exit Pages",
            "query": {
                "metrics": "exits",
                "dimensions": "pagePath",
                "sort": "exits-"
            },
            "more": {
                "reportId": "exit-pages",
                "label": "View Full Report »"
            }
        },
        {
            "type": "grid-card",
            "id": "clickedelements",
            "container": "clicked-elements",
            "title": "Most Clicked Elements",
            "query": {
                "metrics": "eventCount",
                "dimensions": "domElementId",
                "sort": "eventCount-"
            },
            "constraints": [
                {
                    "dimension": "eventName",
                    "value": "click"
                }
            ],
            "more": {
                "reportId": "clicks",
                "label": "View Full Report »"
            }
        },
        {
            "type": "report-links",
            "title": "Content Reports",
            "colspan": 3,
            "links": [
                {
                    "reportId": "domstreams",
                    "label": "Domstream Recordings",
                    "description": "See user mouse movement and keypress recordings."
                },
                {
                    "reportId": "entry-pages",
                    "label": "Entry Pages",
                    "description": "See which web pages users entered on."
                },
                {
                    "reportId": "exit-pages",
                    "label": "Exit Pages",
                    "description": "See which web pages users exited on."
                }
            ]
        }
    ]
}
