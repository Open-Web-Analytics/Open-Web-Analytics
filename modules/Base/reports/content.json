{
    "title": "Content Overview",
    "description": "What was viewed: top pages, the elements clicked on them, and the pages sessions started and ended on.",
    "metrics": "sessions,pageViews",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "pageViews,pageViewsPerSession"
            },
            "chartMetric": "pageViews",
            "colspan": 12
        },
        {
            "type": "grid-card",
            "id": "toppages",
            "container": "top-pages",
            "title": "Pages",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "pagePath",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "pages"
            },
            "rowActions": [
                "heatmap",
                "pathHeatmap",
                "clicks",
                "recordings",
                "paths"
            ]
        },
        {
            "type": "grid-card",
            "id": "clickedelements",
            "container": "clicked-elements",
            "title": "Most Clicked Elements",
            "query": {
                "metrics": "eventCount",
                "dimensions": "domElementId",
                "sort": "eventCount-"
            },
            "constraints": [
                {
                    "dimension": "eventName",
                    "value": "click"
                }
            ],
            "more": {
                "reportId": "clicks"
            },
            "colspan": 6
        },
        {
            "type": "grid-card",
            "id": "entrypages",
            "container": "entry-pages",
            "title": "Entry Pages",
            "query": {
                "metrics": "sessions",
                "dimensions": "landingPage",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "entry-pages"
            },
            "colspan": 6
        },
        {
            "type": "grid-card",
            "id": "exitpages",
            "container": "exit-pages",
            "title": "Exit Pages",
            "query": {
                "metrics": "exits",
                "dimensions": "pagePath",
                "sort": "exits-"
            },
            "more": {
                "reportId": "exit-pages"
            },
            "colspan": 6
        }
    ]
}
