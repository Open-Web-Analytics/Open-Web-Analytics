{
    "title": "Product SKUs",
    "metrics": "lineItemQuantity,lineItemRevenue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "lineItemQuantity",
            "headline": "There were {lineItemQuantity.formatted} products sold across all SKUs."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "productSku",
                "sort": "lineItemQuantity-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "productSku",
                "template": {
                    "do": "base.report",
                    "reportId": "product-sku-detail",
                    "productSku": "%s"
                },
                "valueColumns": "productSku"
            }
        }
    ]
}
