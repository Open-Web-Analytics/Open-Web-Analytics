{
    "title": "Visitor Geolocation",
    "subview": "base.reportDimension",
    "settings": {
        "dimensionLink": {
            "linkColumn": "country",
            "template": {
                "do": "base.report",
                "reportId": "country-detail",
                "country": "%s"
            },
            "valueColumns": "country"
        },
        "dimensions": "country,countryCode",
        "resultsPerPage": 30,
        "sort": "visits-",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from all locations."
    }
}
