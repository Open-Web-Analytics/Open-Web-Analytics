{
    "title": "Host Names",
    "subview": "base.reportWidgets",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from all hosts."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "hostName",
                "sort": "visits-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "hostName",
                "template": {
                    "do": "base.report",
                    "reportId": "host-detail",
                    "hostName": "%s"
                },
                "valueColumns": "hostName"
            }
        }
    ]
}
