{
    "title": "Latest Visits",
    "description": "Visits, the most recent first: when each started, the visitor's address, landing page, source / medium, location and number of prior sessions.",
    "metrics": "sessions,pageViewsPerSession",
    "widgets": [
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "title": "Latest Visits Profile",
            "query": {
                "dimensions": "sessionStartTime,ipAddress,landingPage,sessionSourceMedium,city,country,priorSessionCount",
                "sort": "sessionStartTime-",
                "resultsPerPage": 30
            },
            "constraints": [
                {
                    "dimension": "sessionStartTime",
                    "operator": "notEmpty"
                }
            ]
        }
    ]
}
