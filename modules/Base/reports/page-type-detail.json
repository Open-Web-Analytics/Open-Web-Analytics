{
    "title": "Page Type: ",
    "titleSuffix": "{pageType}",
    "subview": "base.reportWidgets",
    "params": {
        "pageType": {}
    },
    "metrics": "visits,pageViews",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.pageViews.formatted_value *> page views for this page type.",
            "chartMetric": "pageViews"
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "pageType",
                "fromParam": "pageType"
            }
        ],
        "gridTitle": "Top Page Types"
    }
}
