{
    "title": "Transactions Overview",
    "description": "Each transaction by order id, with its revenue, tax, shipping and refunds.",
    "metrics": "sessions,transactions,transactionRevenue,taxRevenue,shippingRevenue,refunds,refundAmount,netRevenue,revenuePerSession,revenuePerTransaction,ecommerceConversionRate",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "transactions"
        },
        {
            "type": "grid",
            "id": "orders",
            "container": "orders-grid",
            "title": "Orders",
            "query": {
                "metrics": "transactionRevenue,taxRevenue,shippingRevenue",
                "dimensions": "transactionId",
                "sort": "transactionRevenue-",
                "resultsPerPage": 25
            },
            "constraints": [
                {
                    "dimension": "eventName",
                    "value": "purchase"
                }
            ]
        }
    ]
}
