{
    "title": "Transactions Overview",
    "description": "Each transaction by order id, with its revenue, tax, shipping and refunds.",
    "metrics": "transactions,transactionRevenue,netRevenue,revenuePerTransaction",
    "widgets": [
        {
            "type": "trend",
            "plotGridRows": false,
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "transactions"
        },
        {
            "type": "metric-boxes",
            "id": "costs",
            "container": "costs-boxes",
            "title": "Tax, shipping and refunds",
            "query": {
                "metrics": "taxRevenue,shippingRevenue,refunds,refundAmount"
            }
        },
        {
            "type": "metric-boxes",
            "id": "rates",
            "container": "rates-boxes",
            "title": "Per session",
            "query": {
                "metrics": "sessions,revenuePerSession,ecommerceConversionRate"
            }
        },
        {
            "type": "grid",
            "id": "orders",
            "container": "orders-grid",
            "title": "Orders",
            "query": {
                "metrics": "transactionRevenue,taxRevenue,shippingRevenue",
                "dimensions": "transactionId",
                "sort": "transactionRevenue-",
                "resultsPerPage": 25
            }
        }
    ]
}
