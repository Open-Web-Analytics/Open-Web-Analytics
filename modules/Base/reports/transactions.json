{
    "title": "Transactions Overview",
    "metrics": "sessions,transactions,transactionRevenue,revenuePerSession,revenuePerTransaction,ecommerceConversionRate",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "transactions"
        },
        {
            "type": "grid",
            "id": "transactions",
            "container": "transactions",
            "query": {
                "metrics": "transactionRevenue,shippingRevenue,taxRevenue",
                "dimensions": "date,transactionId",
                "sort": "timestamp-",
                "resultsPerPage": 25
            },
            "excludeColumns": [
                "date"
            ],
            "title": "Transaction Roster"
        }
    ]
}
