{
    "title": "Transactions Overview",
    "subview": "base.reportWidgets",
    "metrics": "visits,transactions,transactionRevenue,revenuePerVisit,revenuePerTransaction,ecommerceConversionRate",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "transactions",
            "headline": "There were {transactions.formatted} {transactions|transaction|transactions} generating {transactionRevenue.formatted}."
        },
        {
            "type": "grid",
            "id": "transactions",
            "container": "transactions",
            "heading": "Transaction Roster",
            "query": {
                "metrics": "transactionRevenue,shippingRevenue,taxRevenue",
                "dimensions": "timestamp,transactionId",
                "sort": "timestamp-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "transactionId",
                "template": {
                    "do": "base.report",
                    "reportId": "transaction-detail",
                    "transactionId": "%s"
                },
                "valueColumns": "transactionId"
            },
            "excludeColumns": "'timestamp'"
        }
    ]
}
