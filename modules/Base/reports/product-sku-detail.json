{
    "title": "Product SKU: ",
    "titleSuffix": "{productSku}",
    "subview": "base.reportWidgets",
    "params": {
        "productSku": {}
    },
    "metrics": "lineItemQuantity,lineItemRevenue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "lineItemQuantity",
            "headline": "There were {lineItemQuantity.formatted} units sold for this SKU."
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "productSku",
                "fromParam": "productSku"
            }
        ],
        "dimension": "productSku"
    }
}
