{
    "title": "Referring Web Sites",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "referrerHost",
                "sort": "sessions-",
                "resultsPerPage": 30
            }
        }
    ],
    "settings": {
        "constraints": "medium==referral"
    }
}
