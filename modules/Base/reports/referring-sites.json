{
    "title": "Referrals",
    "subview": "base.reportWidgets",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from referrals."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "referralPageTitle,referralPageUrl",
                "sort": "visits-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "referralPageTitle",
                "template": {
                    "do": "base.report",
                    "reportId": "referral-detail",
                    "referralPageUrl": "%s"
                },
                "valueColumns": "referralPageUrl"
            },
            "excludeColumns": "'referralPageUrl'"
        }
    ],
    "settings": {
        "constraints": "medium==referral"
    }
}
