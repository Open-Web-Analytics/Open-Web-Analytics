{
    "title": "Clicks",
    "metrics": "eventCount",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "chartMetric": "eventCount",
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "eventCount"
            },
            "headline": "There were {eventCount.raw} {eventCount|click|clicks} on all elements."
        },
        {
            "type": "grid",
            "id": "elements",
            "container": "clicked-elements",
            "title": "Clicked Elements",
            "query": {
                "metrics": "eventCount",
                "dimensions": "pagePath,domElementId",
                "sort": "eventCount-"
            }
        }
    ]
}
