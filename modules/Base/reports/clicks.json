{
    "title": "Clicks",
    "description": "Click events by page and by the id of the element clicked.",
    "metrics": "eventCount",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "chartMetric": "eventCount",
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "eventCount"
            }
        },
        {
            "type": "grid",
            "id": "elements",
            "container": "clicked-elements",
            "title": "Clicked Elements",
            "query": {
                "metrics": "eventCount",
                "dimensions": "pagePath,domElementId",
                "sort": "eventCount-"
            }
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "eventName",
                "value": "click"
            }
        ]
    }
}
