{
    "title": "Source Detail: ",
    "titleSuffix": "{source}",
    "subview": "base.reportWidgets",
    "params": {
        "source": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from this source."
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "source",
                "fromParam": "source"
            }
        ]
    }
}
