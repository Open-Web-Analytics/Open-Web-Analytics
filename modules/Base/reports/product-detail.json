{
    "title": "Product Detail: ",
    "titleSuffix": "{productName}",
    "subview": "base.reportWidgets",
    "params": {
        "productName": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "metrics": "lineItemQuantity,lineItemRevenue",
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.lineItemQuantity.formatted_value *> units sold for this product.",
            "chartMetric": "lineItemQuantity"
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "productName",
                "fromParam": "productName"
            }
        ],
        "dimension": "productName"
    }
}
