{
    "view": "base.report",
    "title": "Feeds",
    "subview": "base.reportWidgets",
    "metrics": "feedReaders,feedRequests,feedSubscriptions",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.feedReaders.formatted_value *> readers of all feeds.",
            "chartMetric": "feedReaders"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "feedType",
                "sort": "feedReaders-",
                "resultsPerPage": 30
            }
        }
    ]
}
