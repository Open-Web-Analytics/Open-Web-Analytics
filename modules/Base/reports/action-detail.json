{
    "title": "Action Detail: ",
    "titleSuffix": "{actionGroup}: {actionName}",
    "params": {
        "actionGroup": {},
        "actionName": {}
    },
    "metrics": "actions,actionsValue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "actions",
            "headline": "There were {actions.formatted} actions of this type."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "actionLabel",
                "sort": "actions-",
                "resultsPerPage": "30"
            }
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "actionName",
                "fromParam": "actionName"
            },
            {
                "dimension": "actionGroup",
                "fromParam": "actionGroup"
            }
        ]
    }
}
