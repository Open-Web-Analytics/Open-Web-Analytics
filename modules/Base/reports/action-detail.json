{
    "title": "Action Detail: ",
    "titleSuffix": "{actionGroup}: {actionName}",
    "subview": "base.reportWidgets",
    "params": {
        "actionGroup": {},
        "actionName": {}
    },
    "metrics": "actions,actionsValue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.actions.formatted_value *> actions of this type.",
            "chartMetric": "actions"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "actionLabel",
                "sort": "actions-",
                "resultsPerPage": "30"
            }
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "actionName",
                "fromParam": "actionName"
            },
            {
                "dimension": "actionGroup",
                "fromParam": "actionGroup"
            }
        ]
    }
}
