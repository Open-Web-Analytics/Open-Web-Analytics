{
    "title": "Campaigns",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from campaigns."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "sessionCampaign",
                "sort": "visits-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "sessionCampaign",
                "template": {
                    "do": "base.report",
                    "reportId": "campaign-detail",
                    "sessionCampaign": "%s"
                },
                "valueColumns": "sessionCampaign"
            }
        }
    ],
    "settings": {
        "constraints": "campaign!=null"
    }
}
