{
    "title": "Campaigns",
    "description": "Sessions by attributed campaign, for sessions credited to a campaign.",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "attributedCampaign",
                "sort": "sessions-",
                "resultsPerPage": 30
            }
        }
    ],
    "settings": {
        "constraints": "attributedCampaign!=(not set)"
    }
}
