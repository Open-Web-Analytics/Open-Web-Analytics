{
    "title": "Traffic Sources",
    "metrics": "visits",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 6,
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "visits,uniqueVisitors,visitDuration"
            },
            "chartMetric": "visits",
            "headline": "There were {visits.formatted} {visits|visit|visits} from all mediums."
        },
        {
            "type": "grid-card",
            "id": "entryPages",
            "container": "entry-pages",
            "title": "Entry Pages",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "entryPageTitle",
                "sort": "visits-"
            },
            "more": {
                "reportId": "entry-pages",
                "label": "View Full Report »"
            }
        },
        {
            "type": "pie",
            "id": "medium",
            "container": "traffic-sources",
            "colspan": 4,
            "chartMetric": "visits",
            "query": {
                "dimensions": "medium",
                "sort": "visits-"
            },
            "title": "Mediums"
        },
        {
            "type": "pie",
            "id": "source",
            "container": "traffic-sources-source",
            "title": "Sources",
            "colspan": 4,
            "chartMetric": "visits",
            "query": {
                "dimensions": "source",
                "sort": "visits-"
            }
        },
        {
            "type": "pie",
            "id": "campaign",
            "container": "traffic-sources-campaign",
            "title": "Campaigns",
            "colspan": 4,
            "chartMetric": "visits",
            "query": {
                "dimensions": "campaign",
                "sort": "visits-"
            }
        },
        {
            "type": "grid-card",
            "id": "referringSites",
            "container": "referring-sites",
            "title": "Referring Web Sites",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "referralWebSite",
                "sort": "visits-"
            }
        },
        {
            "type": "grid-card",
            "id": "countries",
            "container": "visitor-countries",
            "title": "Countries",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "country",
                "sort": "visits-"
            },
            "more": {
                "reportId": "geolocation",
                "label": "View Full Report »"
            }
        },
        {
            "type": "grid",
            "id": "topsources",
            "container": "top-sources",
            "title": "Top Sources",
            "colspan": 6,
            "query": {
                "dimensions": "source,medium",
                "sort": "visits-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "source",
                "template": {
                    "do": "base.report",
                    "reportId": "source-detail",
                    "source": "%s",
                    "medium": "%s"
                },
                "valueColumns": [
                    "source",
                    "medium"
                ]
            },
            "more": {
                "reportId": "sources",
                "label": "View Full Report »"
            }
        },
        {
            "type": "grid",
            "id": "topreferrals",
            "container": "top-referrals",
            "title": "Top Referrals",
            "colspan": 6,
            "query": {
                "dimensions": "referralPageUrl",
                "sort": "visits-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "referralPageUrl",
                "template": {
                    "do": "base.report",
                    "reportId": "referral-detail",
                    "referralPageUrl": "%s"
                },
                "valueColumns": [
                    "referralPageUrl"
                ]
            },
            "more": {
                "reportId": "referring-sites",
                "label": "View Full Report »"
            }
        }
    ]
}
