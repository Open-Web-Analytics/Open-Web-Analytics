{
    "title": "Traffic Sources",
    "metrics": "sessions",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 6,
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "sessions,totalUsers"
            },
            "chartMetric": "sessions"
        },
        {
            "type": "grid-card",
            "id": "entryPages",
            "container": "entry-pages",
            "title": "Entry Pages",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "landingPageTitle",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "entry-pages",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "pie",
            "id": "sessionMedium",
            "container": "traffic-sources",
            "colspan": 4,
            "chartMetric": "sessions",
            "query": {
                "dimensions": "sessionMedium",
                "sort": "sessions-"
            },
            "title": "Mediums"
        },
        {
            "type": "pie",
            "id": "sessionSource",
            "container": "traffic-sources-source",
            "title": "Sources",
            "colspan": 4,
            "chartMetric": "sessions",
            "query": {
                "dimensions": "sessionSource",
                "sort": "sessions-"
            }
        },
        {
            "type": "pie",
            "id": "sessionCampaign",
            "container": "traffic-sources-campaign",
            "title": "Campaigns",
            "colspan": 4,
            "chartMetric": "sessions",
            "query": {
                "dimensions": "sessionCampaign",
                "sort": "sessions-"
            }
        },
        {
            "type": "grid-card",
            "id": "referringSites",
            "container": "referring-sites",
            "title": "Referring Web Sites",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "referrerHost",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "referring-sites",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "countries",
            "container": "visitor-countries",
            "title": "Countries",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "country",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "geolocation",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "topsources",
            "container": "top-sources",
            "title": "Top Sources",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "sessionSourceMedium",
                "sort": "sessions-",
                "resultsPerPage": 25
            },
            "more": {
                "reportId": "sources",
                "label": "View Full Report \u00bb"
            }
        }
    ]
}
