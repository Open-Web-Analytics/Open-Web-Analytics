{
    "title": "Traffic Sources",
    "description": "Where sessions came from: channels, campaigns, sources, referring sites and landing pages.",
    "metrics": "sessions",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 6,
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "sessions,totalUsers"
            },
            "chartMetric": "sessions"
        },
        {
            "type": "grid-card",
            "id": "entryPages",
            "container": "entry-pages",
            "title": "Entry Pages",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "landingPage",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "entry-pages"
            }
        },
        {
            "type": "pie",
            "id": "attributedChannel",
            "container": "traffic-sources",
            "colspan": 6,
            "chartMetric": "sessions",
            "query": {
                "dimensions": "attributedChannel",
                "sort": "sessions-"
            },
            "title": "Channels"
        },
        {
            "type": "pie",
            "id": "attributedCampaign",
            "container": "traffic-sources-campaign",
            "title": "Campaigns",
            "colspan": 6,
            "chartMetric": "sessions",
            "query": {
                "dimensions": "attributedCampaign",
                "sort": "sessions-"
            },
            "constraints": [
                {
                    "dimension": "attributedCampaign",
                    "operator": "notEmpty"
                },
                {
                    "dimension": "attributedCampaign",
                    "operator": "!~",
                    "value": "^[(](direct|organic|ai-agent|referral)[)]$"
                }
            ]
        },
        {
            "type": "grid-card",
            "id": "topsources",
            "container": "top-sources",
            "title": "Top Sources",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "attributedSourceMedium",
                "sort": "sessions-",
                "resultsPerPage": 25
            },
            "more": {
                "reportId": "sources"
            }
        },
        {
            "type": "grid-card",
            "id": "referringSites",
            "container": "referring-sites",
            "title": "Referring Web Sites",
            "colspan": 6,
            "query": {
                "metrics": "sessions",
                "dimensions": "sessionSource",
                "sort": "sessions-"
            },
            "more": {
                "reportId": "referring-sites"
            },
            "constraints": [
                {
                    "dimension": "sessionMedium",
                    "value": "referral"
                }
            ]
        }
    ]
}
