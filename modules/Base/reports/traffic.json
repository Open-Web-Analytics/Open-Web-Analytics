{
    "title": "Traffic Sources",
    "metrics": "visits",
    "widgets": [
        {
            "type": "trend-card",
            "id": "trend",
            "container": "trend-chart",
            "colspan": 6,
            "query": {
                "dimensions": "date",
                "sort": "date",
                "metrics": "visits,uniqueVisitors"
            },
            "chartMetric": "visits",
            "headline": "There were {visits.formatted} {visits|visit|visits} from all mediums."
        },
        {
            "type": "grid-card",
            "id": "entryPages",
            "container": "entry-pages",
            "title": "Entry Pages",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "landingPageTitle",
                "sort": "visits-"
            },
            "more": {
                "reportId": "entry-pages",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "pie",
            "id": "sessionMedium",
            "container": "traffic-sources",
            "colspan": 4,
            "chartMetric": "visits",
            "query": {
                "dimensions": "sessionMedium",
                "sort": "visits-"
            },
            "title": "Mediums"
        },
        {
            "type": "pie",
            "id": "sessionSource",
            "container": "traffic-sources-source",
            "title": "Sources",
            "colspan": 4,
            "chartMetric": "visits",
            "query": {
                "dimensions": "sessionSource",
                "sort": "visits-"
            }
        },
        {
            "type": "pie",
            "id": "sessionCampaign",
            "container": "traffic-sources-campaign",
            "title": "Campaigns",
            "colspan": 4,
            "chartMetric": "visits",
            "query": {
                "dimensions": "sessionCampaign",
                "sort": "visits-"
            }
        },
        {
            "type": "grid-card",
            "id": "referringSites",
            "container": "referring-sites",
            "title": "Referring Web Sites",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "referralWebSite",
                "sort": "visits-"
            },
            "more": {
                "reportId": "referring-sites",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid-card",
            "id": "countries",
            "container": "visitor-countries",
            "title": "Countries",
            "colspan": 6,
            "query": {
                "metrics": "visits",
                "dimensions": "country",
                "sort": "visits-"
            },
            "more": {
                "reportId": "geolocation",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid",
            "id": "topsources",
            "container": "top-sources",
            "title": "Top Sources",
            "colspan": 6,
            "query": {
                "dimensions": "sessionSource,sessionMedium",
                "sort": "visits-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "sessionSource",
                "template": {
                    "do": "base.report",
                    "reportId": "source-detail",
                    "sessionSource": "%s",
                    "sessionMedium": "%s"
                },
                "valueColumns": [
                    "sessionSource",
                    "sessionMedium"
                ]
            },
            "more": {
                "reportId": "sources",
                "label": "View Full Report \u00bb"
            }
        }
    ]
}
