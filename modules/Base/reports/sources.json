{
    "title": "Sources",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "sessionSource,sessionMedium",
                "sort": "sessions",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "sessionSource",
                "template": {
                    "do": "base.report",
                    "reportId": "source-detail",
                    "sessionSource": "%s"
                },
                "valueColumns": "sessionSource"
            }
        }
    ]
}
