{
    "title": "Sources",
    "subview": "base.reportWidgets",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from all sources."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "source,medium",
                "sort": "visits",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "source",
                "template": {
                    "do": "base.report",
                    "reportId": "source-detail",
                    "source": "%s"
                },
                "valueColumns": "source"
            }
        }
    ]
}
