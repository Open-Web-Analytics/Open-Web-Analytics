{
    "title": "Sources",
    "subview": "base.reportDimension",
    "settings": {
        "dimensionLink": {
            "linkColumn": "source",
            "template": {
                "do": "base.reportSourceDetail",
                "source": "%s"
            },
            "valueColumns": "source"
        },
        "dimensions": "source,medium",
        "resultsPerPage": 30,
        "sort": "visits",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from all sources."
    }
}
