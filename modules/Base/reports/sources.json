{
    "title": "Sources",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from all sources."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "source,medium",
                "sort": "visits",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "source",
                "template": {
                    "do": "base.report",
                    "reportId": "source-detail",
                    "source": "%s"
                },
                "valueColumns": "source"
            }
        }
    ]
}
