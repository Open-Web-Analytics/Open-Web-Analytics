{
    "title": "Page Detail: ",
    "description": "Page views and sessions for one page over the period, and the pages viewed before and after it.",
    "titleSuffix": "{pagePath}",
    "params": {
        "pagePath": {}
    },
    "metrics": "sessions,pageViews",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "chartMetric": "pageViews",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "constraints": [
                {
                    "dimension": "pagePath",
                    "fromParam": "pagePath"
                }
            ]
        },
        {
            "type": "grid-card",
            "id": "previousPages",
            "container": "previous-pages",
            "title": "Previous Pages",
            "colspan": 6,
            "query": {
                "metrics": "pageViews",
                "dimensions": "previousPagePath",
                "sort": "pageViews-"
            },
            "constraints": [
                {
                    "dimension": "pagePath",
                    "fromParam": "pagePath"
                },
                {
                    "dimension": "eventName",
                    "value": "page_view"
                }
            ],
            "link": {
                "linkColumn": "previousPagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pagePath": "%s"
                },
                "valueColumns": "previousPagePath",
                "except": [
                    "(entrance)"
                ]
            }
        },
        {
            "type": "grid-card",
            "id": "nextPages",
            "container": "next-pages",
            "title": "Next Pages",
            "colspan": 6,
            "query": {
                "metrics": "pageViews",
                "dimensions": "nextPagePath",
                "sort": "pageViews-"
            },
            "constraints": [
                {
                    "dimension": "pagePath",
                    "fromParam": "pagePath"
                },
                {
                    "dimension": "eventName",
                    "value": "page_view"
                }
            ],
            "link": {
                "linkColumn": "nextPagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pagePath": "%s"
                },
                "valueColumns": "nextPagePath",
                "except": [
                    "(exit)"
                ]
            }
        }
    ]
}
