{
    "title": "Page Detail: ",
    "description": "Page views and sessions for one page over the period, with links to its heatmap and its element clicks.",
    "titleSuffix": "{pagePath}",
    "params": {
        "pagePath": {}
    },
    "metrics": "sessions,pageViews",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "chartMetric": "pageViews",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "constraints": [
                {
                    "dimension": "pagePath",
                    "fromParam": "pagePath"
                }
            ]
        },
        {
            "type": "heatmap-link",
            "id": "heatmap",
            "container": "heatmap-link",
            "title": "More analytics for this Page:",
            "showTitle": true,
            "pagePath": "{pagePath}",
            "colspan": 3
        },
        {
            "type": "report-links",
            "id": "moreAnalytics",
            "container": "more-analytics",
            "links": [
                {
                    "reportId": "dom-clicks",
                    "label": "Dom Clicks",
                    "description": "analysis of dom clicks.",
                    "params": {
                        "pagePath": "{pagePath}"
                    }
                }
            ],
            "colspan": 3
        }
    ]
}
