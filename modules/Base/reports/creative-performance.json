{
    "title": "Creative Performance",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "sessionAd,landingPage",
                "sort": "sessions-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "sessionAd",
                "template": {
                    "do": "base.report",
                    "reportId": "ad-detail",
                    "sessionAd": "%s"
                },
                "valueColumns": "sessionAd"
            }
        }
    ]
}
