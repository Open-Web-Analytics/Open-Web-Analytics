{
    "title": "Creative Performance",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits for all ads."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "ad,entryPagePath",
                "sort": "visits-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "ad",
                "template": {
                    "do": "base.report",
                    "reportId": "ad-detail",
                    "ad": "%s"
                },
                "valueColumns": "ad"
            }
        }
    ]
}
