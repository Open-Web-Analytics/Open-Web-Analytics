{
    "title": "Creative Performance",
    "subview": "base.reportDimension",
    "settings": {
        "dimensionLink": {
            "linkColumn": "ad",
            "template": {
                "do": "base.report",
                "reportId": "ad-detail",
                "ad": "%s"
            },
            "valueColumns": "ad"
        },
        "dimensions": "ad,entryPagePath",
        "resultsPerPage": 25,
        "sort": "visits-",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits for all ads."
    }
}
