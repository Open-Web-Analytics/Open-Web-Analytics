{
    "title": "Country: ",
    "titleSuffix": "{country}",
    "params": {
        "country": {}
    },
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from this country."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "stateRegion,country",
                "sort": "visits",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "stateRegion",
                "template": {
                    "do": "base.report",
                    "reportId": "state-detail",
                    "stateRegion": "%s",
                    "country": "%s"
                },
                "valueColumns": [
                    "stateRegion",
                    "country"
                ]
            }
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "country",
                "fromParam": "country"
            }
        ]
    }
}
