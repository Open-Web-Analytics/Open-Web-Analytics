{
    "title": "Exit Pages",
    "subview": "base.reportDimension",
    "settings": {
        "dimensionLink": {
            "linkColumn": "exitPagePath",
            "template": {
                "do": "base.reportDocument",
                "pageUrl": "%s"
            },
            "valueColumns": "exitPageUrl"
        },
        "dimensions": "exitPagePath,exitPageUrl,exitPageTitle",
        "excludeColumns": "'exitPageUrl'",
        "gridTitle": "Top Exit Pages",
        "metrics": "visits,pageViews,bounces",
        "resultsPerPage": 30,
        "sort": "visits-",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits to the site."
    }
}
