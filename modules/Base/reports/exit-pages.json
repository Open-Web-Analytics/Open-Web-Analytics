{
    "title": "Exit Pages",
    "subview": "base.reportWidgets",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits to the site."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "exitPagePath,exitPageUrl,exitPageTitle",
                "sort": "visits-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "exitPagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pageUrl": "%s"
                },
                "valueColumns": "exitPageUrl"
            },
            "excludeColumns": "'exitPageUrl'"
        }
    ]
}
