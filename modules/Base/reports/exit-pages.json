{
    "title": "Exit Pages",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits to the site."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "metrics": "pageViews,exits",
                "dimensions": "pagePath,pageTitle",
                "sort": "exits-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "pagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pagePath": "%s"
                },
                "valueColumns": "pagePath"
            }
        }
    ]
}
