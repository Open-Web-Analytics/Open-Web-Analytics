{
    "title": "Ad: ",
    "titleSuffix": "{ad}",
    "subview": "base.reportDimensionDetail",
    "params": {
        "ad": {
            "lowercase": true
        }
    },
    "settings": {
        "constraints": [
            {
                "dimension": "ad",
                "fromParam": "ad"
            }
        ],
        "metrics": "visits,pageViews,bounces",
        "resultsPerPage": 25,
        "sort": "visits-",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from this ad."
    }
}
