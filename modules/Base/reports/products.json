{
    "title": "Products",
    "subview": "base.reportSimpleDimensional",
    "settings": {
        "dimensionLink": {
            "linkColumn": "productName",
            "template": {
                "do": "base.reportProductDetail",
                "productName": "%s"
            },
            "valueColumns": "productName"
        },
        "dimensions": "productName",
        "metrics": "lineItemQuantity,lineItemRevenue",
        "resultsPerPage": 30,
        "sort": "lineItemQuantity-",
        "trendChartMetric": "lineItemQuantity",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.lineItemQuantity.formatted_value *> products sold."
    }
}
