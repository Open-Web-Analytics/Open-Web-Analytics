{
    "title": "Products",
    "subview": "base.reportWidgets",
    "metrics": "lineItemQuantity,lineItemRevenue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.lineItemQuantity.formatted_value *> products sold.",
            "chartMetric": "lineItemQuantity"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "productName",
                "sort": "lineItemQuantity-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "productName",
                "template": {
                    "do": "base.report",
                    "reportId": "product-detail",
                    "productName": "%s"
                },
                "valueColumns": "productName"
            }
        }
    ]
}
