{
    "title": "Search Engines",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "headline": "There were {visits.formatted} visits from search engines."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "referralWebSite",
                "sort": "visits-",
                "resultsPerPage": 30
            }
        }
    ],
    "settings": {
        "constraints": "medium==organic-search"
    }
}
