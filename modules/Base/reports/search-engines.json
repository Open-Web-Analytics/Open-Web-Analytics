{
    "title": "Search Engines",
    "description": "Sessions from organic search, by search engine.",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "sessionSource",
                "sort": "sessions-",
                "resultsPerPage": 30
            }
        }
    ],
    "settings": {
        "constraints": "sessionChannel==Organic Search"
    }
}
