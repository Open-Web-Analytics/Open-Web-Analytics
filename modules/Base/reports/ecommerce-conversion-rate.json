{
    "title": "Conversion Rate",
    "description": "The share of sessions with a transaction, by day, and by attributed channel.",
    "metrics": "sessions,ecommerceConversionRate",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "ecommerceConversionRate"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "attributedChannel",
                "sort": "ecommerceConversionRate-",
                "resultsPerPage": 30
            }
        }
    ]
}
