{
    "title": "Product Category: ",
    "titleSuffix": "{productCategory}",
    "subview": "base.reportWidgets",
    "params": {
        "productCategory": {}
    },
    "metrics": "lineItemQuantity,lineItemRevenue",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.lineItemQuantity.formatted_value *> units sold for this SKU.",
            "chartMetric": "lineItemQuantity"
        }
    ],
    "settings": {
        "constraints": [
            {
                "dimension": "productCategory",
                "fromParam": "productCategory"
            }
        ],
        "dimension": "productCategory"
    }
}
