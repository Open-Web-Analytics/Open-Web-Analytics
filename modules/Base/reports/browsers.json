{
    "title": "Browser Types",
    "subview": "base.reportWidgets",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits for all browser types."
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "browserType",
                "sort": "visits-",
                "resultsPerPage": 25
            },
            "link": {
                "linkColumn": "browserType",
                "template": {
                    "do": "base.report",
                    "reportId": "browser-detail",
                    "browserType": "%s"
                },
                "valueColumns": "browserType"
            }
        }
    ]
}
