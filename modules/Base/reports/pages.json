{
    "title": "Pages",
    "description": "Page views and sessions by page: its path and query string. Each page leads to its heatmap, its element clicks, its recordings and the pages before and after it.",
    "metrics": "pageViews,sessions,pageViews",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "pageViews"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "pagePathPlusQuery",
                "sort": "pageViews-",
                "resultsPerPage": 30
            },
            "rowActions": [
                "heatmap",
                "clicks",
                "recordings",
                "paths"
            ]
        }
    ]
}
