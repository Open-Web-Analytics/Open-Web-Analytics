{
    "title": "Web Pages",
    "subview": "base.reportWidgets",
    "metrics": "pageViews,visits,uniquePageViews",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "title": "There were <*= this.d.resultSet.aggregates.pageViews.formatted_value *> page views for <*= this.d.resultSet.aggregates.uniquePageViews.value *> unique pages.",
            "chartMetric": "pageViews"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "pagePath,pageTitle,pageType,pageUrl",
                "sort": "pageViews-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "pagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pageUrl": "%s"
                },
                "valueColumns": "pageUrl"
            },
            "excludeColumns": "'pageUrl'"
        }
    ],
    "settings": {
        "gridTitle": "Top Pages"
    }
}
