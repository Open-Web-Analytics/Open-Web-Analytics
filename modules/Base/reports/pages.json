{
    "title": "Pages",
    "metrics": "pageViews,sessions,pageViews",
    "widgets": [
        {
            "type": "trend",
            "id": "trend",
            "container": "trend-chart",
            "query": {
                "dimensions": "date",
                "sort": "date"
            },
            "chartMetric": "pageViews"
        },
        {
            "type": "grid",
            "id": "dim",
            "container": "dimension-grid",
            "query": {
                "dimensions": "pagePath,pageTitle,contentGroup",
                "sort": "pageViews-",
                "resultsPerPage": 30
            },
            "link": {
                "linkColumn": "pagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pagePath": "%s"
                },
                "valueColumns": "pagePath"
            }
        }
    ]
}
