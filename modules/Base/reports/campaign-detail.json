{
    "title": "Campaign: ",
    "titleSuffix": "{campaign}",
    "subview": "base.reportDimensionDetail",
    "params": {
        "campaign": {
            "lowercase": true
        }
    },
    "settings": {
        "constraints": [
            {
                "dimension": "campaign",
                "fromParam": "campaign"
            }
        ],
        "metrics": "visits,pageViews,bounces",
        "resultsPerPage": 25,
        "sort": "visits-",
        "trendChartMetric": "visits",
        "trendTitle": "There were <*= this.d.resultSet.aggregates.visits.formatted_value *> visits from this campaign."
    }
}
