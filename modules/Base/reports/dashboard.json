{
    "title": "Dashboard",
    "metrics": "sessions,totalUsers,pageViews,pageViewsPerSession",
    "widgets": [
        {
            "type": "trend-card",
            "id": "siteTrend",
            "container": "trend-chart",
            "title": "Site Metrics",
            "showTitle": true,
            "chartMetric": "totalUsers",
            "query": {
                "metrics": "totalUsers,pageViews,pageViewsPerSession",
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid-card",
            "id": "topContent",
            "container": "top-pages",
            "title": "Top Content",
            "colspan": 6,
            "query": {
                "metrics": "pageViews",
                "dimensions": "pagePath",
                "sort": "pageViews-"
            },
            "link": {
                "linkColumn": "pagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pagePath": "%s"
                },
                "valueColumns": "pagePath"
            },
            "more": {
                "reportId": "pages"
            }
        },
        {
            "type": "pie",
            "id": "visitorTypes",
            "container": "visitor-types",
            "title": "Visitor Types",
            "colspan": 3,
            "query": {
                "metrics": "sessions",
                "dimensions": "newVsReturning",
                "sort": "sessions-"
            },
            "chartMetric": "sessions"
        },
        {
            "type": "pie",
            "id": "visitorMediums",
            "container": "visitor-mediums",
            "title": "Traffic Sources",
            "colspan": 3,
            "chartMetric": "sessions",
            "query": {
                "metrics": "sessions",
                "dimensions": "sessionMedium",
                "sort": "sessions-"
            }
        },
        {
            "type": "grid-card",
            "id": "topReferrers",
            "container": "top-referers",
            "title": "Top Referrers",
            "colspan": 3,
            "constraints": [
                {
                    "dimension": "sessionMedium",
                    "value": "referral"
                }
            ],
            "query": {
                "metrics": "sessions",
                "dimensions": "referrerHost",
                "sort": "sessions-",
                "resultsPerPage": 10
            },
            "more": {
                "reportId": "referring-sites",
                "label": "View Full Report \u00bb"
            }
        },
        {
            "type": "grid",
            "id": "latestVisits",
            "container": "latest-visits",
            "title": "Latest Visits",
            "query": {
                "metrics": "pageViewsPerSession",
                "dimensions": "ipAddress,hostName,landingPage,sessionMedium,sessionSource,city,country,priorSessionCount",
                "sort": "sessions-",
                "resultsPerPage": 10
            },
            "more": {
                "reportId": "latest-visits"
            }
        }
    ]
}
