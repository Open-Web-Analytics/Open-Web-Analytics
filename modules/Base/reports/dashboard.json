{
    "title": "Dashboard",
    "metrics": "visits,uniqueVisitors,pageViews,bounceRate,pagesPerVisit,visitDuration",
    "widgets": [
        {
            "type": "trend-card",
            "id": "siteTrend",
            "container": "trend-chart",
            "title": "Site Metrics",
            "showTitle": true,
            "chartMetric": "uniqueVisitors",
            "query": {
                "metrics": "uniqueVisitors,pageViews,bounceRate,pagesPerVisit,visitDuration",
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid-card",
            "id": "topContent",
            "container": "top-pages",
            "title": "Top Content",
            "colspan": 6,
            "query": {
                "metrics": "pageViews",
                "dimensions": "pagePath",
                "sort": "pageViews-"
            },
            "link": {
                "linkColumn": "pagePath",
                "template": {
                    "do": "base.report",
                    "reportId": "document",
                    "pagePath": "%s"
                },
                "valueColumns": "pagePath"
            },
            "more": {
                "reportId": "pages"
            }
        },
        {
            "type": "pie",
            "id": "visitorTypes",
            "container": "visitor-types",
            "title": "Visitor Types",
            "colspan": 3,
            "query": {
                "metrics": "visits",
                "dimensions": "isRepeatVisitor",
                "sort": "visits-"
            },
            "chartMetric": "visits",
            "valueLabels": {
                "1": "Repeat",
                "0": "New",
                "": "New"
            }
        },
        {
            "type": "pie",
            "id": "visitorMediums",
            "container": "visitor-mediums",
            "title": "Traffic Sources",
            "colspan": 3,
            "chartMetric": "visits",
            "query": {
                "metrics": "visits",
                "dimensions": "medium",
                "sort": "visits-"
            }
        },
        {
            "type": "grid",
            "id": "actions",
            "container": "actions-trend",
            "title": "Actions",
            "colspan": 3,
            "query": {
                "metrics": "actions",
                "dimensions": "actionGroup,actionName",
                "sort": "actions-",
                "resultsPerPage": 5
            },
            "link": {
                "linkColumn": "actionGroup",
                "template": {
                    "do": "base.report",
                    "reportId": "action-group",
                    "actionGroup": "%s"
                },
                "valueColumns": "actionGroup"
            },
            "more": {
                "reportId": "action-tracking"
            }
        },
        {
            "type": "grid",
            "id": "topReferrers",
            "container": "top-referers",
            "title": "Top Referrers",
            "colspan": 3,
            "constraints": [
                {
                    "dimension": "medium",
                    "value": "referral"
                }
            ],
            "query": {
                "metrics": "visits",
                "dimensions": "referralPageTitle,referralPageUrl",
                "sort": "visits-",
                "resultsPerPage": 10
            },
            "excludeColumns": [
                "referralPageTitle"
            ],
            "link": {
                "linkColumn": "referralPageUrl",
                "template": {
                    "do": "base.report",
                    "reportId": "referral-detail",
                    "referralPageUrl": "%s"
                },
                "valueColumns": "referralPageUrl"
            },
            "more": {
                "reportId": "referring-sites"
            }
        },
        {
            "type": "grid",
            "id": "latestVisits",
            "container": "latest-visits",
            "title": "Latest Visits",
            "query": {
                "metrics": "visits,pagesPerVisit,visitDuration",
                "dimensions": "ipAddress,entryPagePath,medium,source,city,country,priorVisitCount",
                "sort": "visits-",
                "resultsPerPage": 10
            },
            "more": {
                "reportId": "latest-visits"
            }
        }
    ]
}
