{
    "title": "Dashboard",
    "description": "The Property's users, page views and engagement, with its top events, pages, channels, sources and visits.",
    "metrics": "sessions,totalUsers,pageViews,pageViewsPerSession",
    "widgets": [
        {
            "type": "trend-card",
            "id": "siteTrend",
            "container": "trend-chart",
            "title": "Site Metrics",
            "showTitle": true,
            "colspan": 12,
            "chartMetric": "totalUsers",
            "query": {
                "metrics": "totalUsers,pageViews,pageViewsPerSession,engagementRate,averageEngagementTimePerSession",
                "dimensions": "date",
                "sort": "date"
            }
        },
        {
            "type": "grid-card",
            "id": "eventNames",
            "container": "event-names",
            "title": "Events",
            "colspan": 4,
            "query": {
                "metrics": "eventCount",
                "dimensions": "eventName",
                "sort": "eventCount-"
            },
            "more": {
                "reportId": "events"
            }
        },
        {
            "type": "pie",
            "id": "visitorTypes",
            "container": "visitor-types",
            "title": "Visitor Types",
            "colspan": 4,
            "query": {
                "metrics": "sessions",
                "dimensions": "newVsReturning",
                "sort": "sessions-"
            },
            "chartMetric": "sessions"
        },
        {
            "type": "pie",
            "id": "visitorMediums",
            "container": "visitor-mediums",
            "title": "Channels",
            "colspan": 4,
            "chartMetric": "sessions",
            "query": {
                "metrics": "sessions",
                "dimensions": "attributedChannel",
                "sort": "sessions-"
            }
        },
        {
            "type": "grid-card",
            "id": "topContent",
            "container": "top-pages",
            "title": "Top Content",
            "colspan": 6,
            "query": {
                "metrics": "pageViews",
                "dimensions": "pagePath",
                "sort": "pageViews-"
            },
            "more": {
                "reportId": "pages"
            },
            "constraints": [
                {
                    "dimension": "eventName",
                    "value": "page_view"
                }
            ],
            "rowActions": [
                "heatmap",
                "pathHeatmap",
                "clicks",
                "recordings",
                "paths"
            ]
        },
        {
            "type": "grid-card",
            "id": "topReferrers",
            "container": "top-referers",
            "title": "Top Referrers",
            "colspan": 6,
            "constraints": [
                {
                    "dimension": "sessionMedium",
                    "value": "referral"
                }
            ],
            "query": {
                "metrics": "sessions",
                "dimensions": "sessionSource",
                "sort": "sessions-",
                "resultsPerPage": 10
            },
            "more": {
                "reportId": "referring-sites"
            }
        },
        {
            "type": "grid",
            "id": "latestVisits",
            "container": "latest-visits",
            "title": "Most Recent Visits",
            "query": {
                "metrics": "pageViewsPerSession",
                "dimensions": "sessionStartTime,ipAddress,landingPage,sessionSourceMedium,city,country,priorSessionCount",
                "sort": "sessionStartTime-",
                "resultsPerPage": 10
            },
            "constraints": [
                {
                    "dimension": "sessionStartTime",
                    "operator": "notEmpty"
                }
            ],
            "more": {
                "reportId": "latest-visits"
            }
        }
    ]
}
