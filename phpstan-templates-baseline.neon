########################################################################
# Baseline for the template gate (phpstan-templates.neon).
#
# EVERY ENTRY HERE IS THE SAME BUG: an admin add/edit form template whose
# view var is set on only ONE of its two branches. sites_addoredit.php,
# users_addoredit.php and options_goal_entry.php each serve both "add" and
# "edit", and the tell is that the suppression is mixed WITHIN a single
# file -- sites_addoredit.php reads $site['site_id'] bare on lines 14-23
# (the edit branch, where the controller sets it) and @$site['domain']
# from line 26 on (the add branch, where it does not).
#
# The fix is controller-side default hoisting -- set 'site' => [] on the
# add path -- and only THEN migrate the read to $view->site[...] and drop
# the @. Doing it the other way round turns a silent empty string into a
# 500, because $view->neverSet throws where a bare undefined var merely
# warned. That work changes rendered admin HTML, so it belongs in its own
# PR with crawl evidence rather than riding along with the gate.
#
# This baseline is a RATCHET, not a permanent allowance: the gate sets
# reportUnmatchedIgnoredErrors: true, so once one of these is fixed the
# stale entry FAILS the build until it is regenerated:
#   composer phpstan:templates -- --generate-baseline=phpstan-templates-baseline.neon
########################################################################
parameters:
	ignoreErrors:
		-
			message: '#^Variable \$goal might not be defined\.$#'
			identifier: variable.undefined
			count: 5
			path: modules/Base/templates/options_goal_entry.php

		-
			message: '#^Variable \$goal_groups might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: modules/Base/templates/options_goal_entry.php

		-
			message: '#^Variable \$config might not be defined\.$#'
			identifier: variable.undefined
			count: 6
			path: modules/Base/templates/sites_addoredit.php

		-
			message: '#^Variable \$site might not be defined\.$#'
			identifier: variable.undefined
			count: 9
			path: modules/Base/templates/sites_addoredit.php

		-
			message: '#^Variable \$validation_errors might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: modules/Base/templates/sites_addoredit.php

		-
			message: '#^Variable \$user might not be defined\.$#'
			identifier: variable.undefined
			count: 7
			path: modules/Base/templates/users_addoredit.php
