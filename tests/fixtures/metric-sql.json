{
    "averageEngagementTime": [
        {
            "kind": "ratio",
            "numerator": "totalEngagementTime",
            "denominator": "visits",
            "precision": 0,
            "children": [
                "totalEngagementTime",
                "visits"
            ]
        }
    ],
    "domClicks": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.event_type = 'click' THEN 1 ELSE 0 END)",
            "alias": "domClicks"
        }
    ],
    "eventCount": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(event.id)",
            "alias": "eventCount"
        }
    ],
    "eventsPerSession": [
        {
            "kind": "ratio",
            "numerator": "eventCount",
            "denominator": "visits",
            "precision": 2,
            "children": [
                "eventCount",
                "visits"
            ]
        }
    ],
    "exits": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.is_exit = 1 THEN 1 ELSE 0 END)",
            "alias": "exits"
        }
    ],
    "keyEvents": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.is_goal_event = 1 THEN 1 ELSE 0 END)",
            "alias": "keyEvents"
        }
    ],
    "newVisitors": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(DISTINCT CASE WHEN event.prior_sessions = 0 THEN event.visitor_id END)",
            "alias": "newVisitors"
        }
    ],
    "pageViews": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.event_type = 'page_view' THEN 1 ELSE 0 END)",
            "alias": "pageViews"
        }
    ],
    "pagesPerVisit": [
        {
            "kind": "ratio",
            "numerator": "pageViews",
            "denominator": "visits",
            "precision": 2,
            "children": [
                "pageViews",
                "visits"
            ]
        }
    ],
    "returningVisitors": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(DISTINCT CASE WHEN event.prior_sessions > 0 THEN event.visitor_id END)",
            "alias": "returningVisitors"
        }
    ],
    "sessionsPerUser": [
        {
            "kind": "ratio",
            "numerator": "visits",
            "denominator": "uniqueVisitors",
            "precision": 2,
            "children": [
                "uniqueVisitors",
                "visits"
            ]
        }
    ],
    "totalEngagementTime": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "SUM(event.engagement_msec)",
            "alias": "totalEngagementTime"
        }
    ],
    "uniqueVisitors": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(DISTINCT event.visitor_id)",
            "alias": "uniqueVisitors"
        }
    ],
    "visits": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(DISTINCT event.session_id)",
            "alias": "visits"
        }
    ]
}
