{
    "averageEngagementTimePerSession": [
        {
            "kind": "ratio",
            "numerator": "totalEngagementTime",
            "denominator": "sessions",
            "precision": 0,
            "children": [
                "sessions",
                "totalEngagementTime"
            ]
        }
    ],
    "averageEngagementTimePerUser": [
        {
            "kind": "ratio",
            "numerator": "totalEngagementTime",
            "denominator": "totalUsers",
            "precision": 0,
            "children": [
                "totalEngagementTime",
                "totalUsers"
            ]
        }
    ],
    "ecommerceConversionRate": [
        {
            "kind": "ratio",
            "numerator": "transactions",
            "denominator": "sessions",
            "precision": 4,
            "children": [
                "sessions",
                "transactions"
            ]
        }
    ],
    "eventCount": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(event.id)",
            "alias": "eventCount"
        }
    ],
    "eventCountPerUser": [
        {
            "kind": "ratio",
            "numerator": "eventCount",
            "denominator": "totalUsers",
            "precision": 2,
            "children": [
                "eventCount",
                "totalUsers"
            ]
        }
    ],
    "eventsPerSession": [
        {
            "kind": "ratio",
            "numerator": "eventCount",
            "denominator": "sessions",
            "precision": 2,
            "children": [
                "eventCount",
                "sessions"
            ]
        }
    ],
    "exits": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.is_exit = 1 THEN 1 ELSE 0 END)",
            "alias": "exits"
        }
    ],
    "keyEvents": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.is_goal_event = 1 THEN 1 ELSE 0 END)",
            "alias": "keyEvents"
        }
    ],
    "newUsers": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(DISTINCT CASE WHEN event.prior_sessions = 0 THEN event.visitor_id END)",
            "alias": "newUsers"
        }
    ],
    "pageViews": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.event_type = 'page_view' THEN 1 ELSE 0 END)",
            "alias": "pageViews"
        }
    ],
    "pageViewsPerSession": [
        {
            "kind": "ratio",
            "numerator": "pageViews",
            "denominator": "sessions",
            "precision": 2,
            "children": [
                "pageViews",
                "sessions"
            ]
        }
    ],
    "pageViewsPerUser": [
        {
            "kind": "ratio",
            "numerator": "pageViews",
            "denominator": "totalUsers",
            "precision": 2,
            "children": [
                "pageViews",
                "totalUsers"
            ]
        }
    ],
    "revenuePerSession": [
        {
            "kind": "ratio",
            "numerator": "transactionRevenue",
            "denominator": "sessions",
            "precision": 0,
            "children": [
                "sessions",
                "transactionRevenue"
            ]
        }
    ],
    "revenuePerTransaction": [
        {
            "kind": "ratio",
            "numerator": "transactionRevenue",
            "denominator": "transactions",
            "precision": 0,
            "children": [
                "transactionRevenue",
                "transactions"
            ]
        }
    ],
    "revenuePerUser": [
        {
            "kind": "ratio",
            "numerator": "transactionRevenue",
            "denominator": "totalUsers",
            "precision": 0,
            "children": [
                "totalUsers",
                "transactionRevenue"
            ]
        }
    ],
    "sessionKeyEventRate": [
        {
            "kind": "ratio",
            "numerator": "keyEvents",
            "denominator": "sessions",
            "precision": 4,
            "children": [
                "keyEvents",
                "sessions"
            ]
        }
    ],
    "sessions": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(DISTINCT event.session_id)",
            "alias": "sessions"
        }
    ],
    "sessionsPerUser": [
        {
            "kind": "ratio",
            "numerator": "sessions",
            "denominator": "totalUsers",
            "precision": 2,
            "children": [
                "sessions",
                "totalUsers"
            ]
        }
    ],
    "totalEngagementTime": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "SUM(event.engagement_msec)",
            "alias": "totalEngagementTime"
        }
    ],
    "totalUsers": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "COUNT(DISTINCT event.visitor_id)",
            "alias": "totalUsers"
        }
    ],
    "transactionRevenue": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.event_type = 'purchase' THEN event.revenue ELSE 0 END)",
            "alias": "transactionRevenue"
        }
    ],
    "transactions": [
        {
            "kind": "aggregate",
            "entity": "base.event",
            "expression": "sum(CASE WHEN event.event_type = 'purchase' THEN 1 ELSE 0 END)",
            "alias": "transactions"
        }
    ],
    "userKeyEventRate": [
        {
            "kind": "ratio",
            "numerator": "keyEvents",
            "denominator": "totalUsers",
            "precision": 4,
            "children": [
                "keyEvents",
                "totalUsers"
            ]
        }
    ]
}
