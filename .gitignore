/vendor/
/owa-data/
owa-config.php
node_modules/
# Web-facing built asset tree -- emitted by webpack (the tracker family, reporting JS,
# combined CSS + their copied url() deps). Pure build output, regenerated by
# `npm run build`; shipped in the release tarball, never committed. The tracker family
# used to build to modules/base/dist/ but now lands here with everything else. See
# webpack.config.js / build.manifest.json.
#
# Except public/.htaccess, which is source: it grants access to the tree without the
# <If> expression in the root .htaccess, which some servers do not support.
/public/*
!/public/.htaccess
/.phpunit.cache/
/test-results/
/playwright-report/
owa-data/e2e-selfhost-logs/
