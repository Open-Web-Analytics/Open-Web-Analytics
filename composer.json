{
    "name": "open-web-analytics/open-web-analytics",
    "description": "The open source analytics framework.",
    "keywords": ["open-web-analytics","owa","web-analytics","analytics"],
    "homepage": "https://www.openwebanalytics.com",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "The OWA Team",
            "email": "hello@openwebanalytics.com"
        }
    ],
    
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    
    
    "require": {
        "php": ">=8.2",
        "wikimedia/composer-merge-plugin": "^2.0"
    },

    "autoload": {
        "classmap": [
            "owa_base.php", "owa_coreAPI.php", "owa_db.php", "owa_lib.php",
            "owa_auth.php", "owa_caller.php", "owa_controller.php",
            "owa_adminController.php", "owa_reportController.php", "owa_entity.php",
            "owa_httpRequest.php", "owa_install.php", "owa_location.php",
            "owa_metric.php", "owa_module.php", "owa_observer.php",
            "owa_requestContainer.php", "owa_template.php", "owa_view.php",
            "modules/",
            "plugins/",
            "includes/"
        ]
    },

    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },

    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpstan:migration": "phpstan analyse -c phpstan-migration.neon --memory-limit=1G",
        "test": "phpunit"
    },

    "extra": {
        "merge-plugin": {
            "include": [
                "modules/*/composer.json"
            ],
            "replace": false,
            "ignore-duplicates": true,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": true
        }
    }
}
